        // 4. Виведення вмісту одновимірного масиву ДО виконання завдання
        System.out.println("\n[ Початковий масив студентів (Всього: " + students.length + ") ]:");
        StudentManager.printTable(students);

        // 5. Виконання послідовного пошуку елементів для видалення
        boolean[] deleteMask = StudentManager.sequentialSearchForDeletion(students);

        // Рахуємо скільки знайдено
        int foundCount = 0;
        for (boolean b : deleteMask) if (b) foundCount++;
        System.out.println("\n>> Послідовним пошуком знайдено студентів для видалення: " + foundCount);

        // Видалення знайдених елементів
        Student[] updatedStudents = StudentManager.removeStudents(students, deleteMask);

        // 6. Виведення вмісту одновимірного масиву ПІСЛЯ зміни
        System.out.println("\n[ Оновлений масив студентів після видалення (Всього: " + updatedStudents.length + ") ]:");
        StudentManager.printTable(updatedStudents);
    }
}
