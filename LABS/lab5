// ==========================================
// 1. Опис класу "Студент" згідно з Варіантом 13
// ==========================================
class Student {
    private String lastName;       // Прізвище
    private String firstName;      // Ім'я
    private int course;            // Курс
    private int cityCode;          // Код міста (тризначне число)
    private boolean hasHomePhone;  // Ознака наявності домашнього телефону (true - так, false - ні)

    public Student(String lastName, String firstName, int course, int cityCode, boolean hasHomePhone) {
        this.lastName = lastName;
        this.firstName = firstName;
        this.course = course;
        this.cityCode = cityCode;
        this.hasHomePhone = hasHomePhone;
    }

    // Геттери
    public String getLastName() { return lastName; }
    public String getFirstName() { return firstName; }
    public int getCourse() { return course; }
    public int getCityCode() { return cityCode; }
    public boolean isHasHomePhone() { return hasHomePhone; }
}

// ==========================================
// 2. Клас для роботи з пошуком та модифікацією масиву
// ==========================================
class StudentManager {
    // Константа для коду міста Львів
    public static final int LVIV_CODE = 322;

    /**
     * Метод послідовного (лінійного) пошуку студентів, які підлягають видаленню.
     * Критерій: 1 курс, місто Львів (код 322), немає домашнього телефону (false).
     * Повертає масив логічних значень (маску), де true означає, що елемент треба видалити.
     */
    public static boolean[] sequentialSearchForDeletion(Student[] array) {
        boolean[] toDelete = new boolean[array.length];

        // Послідовний (лінійний) обхід масиву від початку до кінця
        for (int i = 0; i < array.length; i++) {
            if (array[i].getCourse() == 1 && 
                array[i].getCityCode() == LVIV_CODE && 
                !array[i].isHasHomePhone()) {
                
                toDelete[i] = true; // Елемент знайдено послідовним пошуком
            }
        }
        return toDelete;
    }

    /**
     * Метод видалення знайдених студентів із масиву
     */
    public static Student[] removeStudents(Student[] array, boolean[] toDelete) {
        // Підраховуємо скільки елементів залишиться
        int remainingCount = 0;
        for (boolean delete : toDelete) {
            if (!delete) remainingCount++;
        }

        // Створюємо новий масив меншого розміру
        Student[] newArray = new Student[remainingCount];
        int newIndex = 0;

        for (int i = 0; i < array.length; i++) {
            if (!toDelete[i]) {
                newArray[newIndex] = array[i];
                newIndex++;
            }
        }
        return newArray;
    }

    /**
     * Допоміжний метод для гарного виведення масиву у вигляді таблиці
     */
    public static void printTable(Student[] array) {
        System.out.println("+-----------------+--------------+------+-----------+------------------+");
        System.out.printf("| %-15s | %-12s | %-4s | %-9s | %-16s |\n", 
                "Прізвище", "Ім'я", "Курс", "Код міста", "Домашній телефон");
        System.out.println("+-----------------+--------------+------+-----------+------------------+");
        for (Student s : array) {
            String phoneStatus = s.isHasHomePhone() ? "Є (Так)" : "Немає (Ні)";
            // Підсвічуємо Львів для наочності
            String cityStr = (s.getCityCode() == LVIV_CODE) ? s.getCityCode() + " (Львів)" : String.valueOf(s.getCityCode());
            
            System.out.printf("| %-15s | %-12s | %-4d | %-9s | %-16s |\n", 
                    s.getLastName(), s.getFirstName(), s.getCourse(), cityStr, phoneStatus);
        }
        System.out.println("+-----------------+--------------+------+-----------+------------------+");
    }
}

