            new Student("Мельник", "Артем", 1, 501, false),
            new Student("Ткаченко", "Тетяна", 2, 550, true),
            new Student("Лисенко", "Євген", 4, 602, true),
            new Student("Романова", "Аліна", 1, 701, false),
            new Student("Павленко", "Микола", 3, 750, true),
            new Student("Савченко", "Юрій", 2, 801, false),
            new Student("Мороз", "Наталія", 1, 880, true),
            new Student("Харченко", "Ігор", 4, 910, false)
