            new Student("Кравченко", "Вадим", 4, 322, true),   // Залишається (4 курс)
            new Student("Гончар", "Ірина", 1, 322, false),   // ПІДЛЯГАЄ ВИДАЛЕННЮ (1 курс, Львів, немає тел.)
            
            new Student("Поліщук", "Олег", 2, 405, true),
